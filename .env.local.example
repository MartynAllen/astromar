# Copy to .env.local and fill in. .env.local is git-ignored.

# Sanity — from sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write-scoped token, used server-side only by scripts/import-photos.ts
SANITY_API_TOKEN=

# Site — used for canonical URLs, sitemap, OG images. Defaults to localhost if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — from dashboard.stripe.com/apikeys. Test key for dev/preview, live for production.
# Used server-side only (app/api/checkout, app/api/stripe-webhook) — hosted Checkout redirect
# means no Stripe.js on the page, so no NEXT_PUBLIC_ key is needed.
STRIPE_SECRET_KEY=
# Issued per registered webhook endpoint — for local dev, run
# `stripe listen --forward-to localhost:3000/api/stripe-webhook` to get a test-mode value.
STRIPE_WEBHOOK_SECRET=

# Prodigi — from dashboard.prodigi.com → Settings → API access. Sandbox key for dev/preview,
# live key for production. Used server-side only (app/api/stripe-webhook).
PRODIGI_API_KEY=
# https://api.sandbox.prodigi.com/v4.0 for dev/preview, https://api.prodigi.com/v4.0 for production.
PRODIGI_API_BASE_URL=https://api.sandbox.prodigi.com/v4.0

# Optional — a Discord or Slack incoming-webhook URL. If a Prodigi order fails after a
# customer has already been charged, one alert is posted here so it doesn't go unnoticed.
ALERT_WEBHOOK_URL=

# Contact form (app/api/contact) — delivers submissions to your own inbox via Resend's
# API, without ever putting an email address in the site's markup. Get a free API key at
# resend.com/api-keys (no sending-domain verification needed — see lib/resend.ts).
RESEND_API_KEY=
# Where contact form messages actually land. Your own email address — never exposed to
# the client, only read server-side by app/api/contact/route.ts.
CONTACT_TO_EMAIL=
